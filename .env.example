# Copy to .env.local and fill in when ready. Never commit real values.

# Amplitude ingestion key — DO NOT set this until the key has been
# explicitly confirmed as the project's own Amplitude ingestion key.
# See src/js/analytics.js.
VITE_AMPLITUDE_API_KEY=

# Set once the site has a real deployed URL. Used for canonical links and
# Open Graph tags — see src/config/site.js. Leave empty until then.
VITE_SITE_URL=

# Real Open Graph share image, once one exists.
VITE_OG_IMAGE_URL=

# --- Cloudflare Pages Function functions/api/track.js -------------------
# NOT Vite variables: set these in Cloudflare Pages → Settings →
# Variables and Secrets (production), never in a committed file.
# CONTROL_TOWER_INGEST_URL=https://revenue-hub-proto.emergent.host/api/ingest/kolaidees
# KOLAIDEES_INGEST_TOKEN=   (secret, same value as in 1CLIC Control Tower)

# --- Newsletter (Pages Functions functions/api/newsletter/*) -------------
# Set in Cloudflare Pages → Settings → Variables and Secrets (production).
# RESEND_API_KEY=              (secret)
# NEWSLETTER_FROM=KOLAidees <nouveautes@your-verified-domain>
# NEWSLETTER_SIGNING_SECRET=   (secret, long random string)
# RESEND_SEGMENT_ID=           (optional — segment for KOLAidees subscribers)
