# Copy to .env.local and fill in when ready. Never commit real values.

# Amplitude ingestion key — DO NOT set this until the key has been
# explicitly confirmed as the project's own Amplitude ingestion key.
# See src/js/analytics.js.
VITE_AMPLITUDE_API_KEY=

# Set once the site has a real deployed URL. Used for canonical links and
# Open Graph tags — see src/config/site.js. Leave empty until then.
VITE_SITE_URL=

# Real Open Graph share image, once one exists.
VITE_OG_IMAGE_URL=
